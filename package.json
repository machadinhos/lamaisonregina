    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@next/third-parties": "^16.3.6",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-slick": "^0.31.0",
    "slick-carousel": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-slick": "^0.23.13",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
